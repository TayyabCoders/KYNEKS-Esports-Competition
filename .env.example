# Neon Postgres connection string (Neon dashboard > Connect).
# Use the DIRECT string (host without "-pooler") for `prisma migrate` / `prisma db push`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Neon Object Storage (S3-compatible). Dashboard > Storage > generate a credential.
AWS_ENDPOINT_URL_S3="https://YOUR-ENDPOINT.neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="auto"
S3_BUCKET_NAME="payment-recipts"

# Optional (already used by the site)
# NEXT_PUBLIC_SITE_URL="https://kynexs.com"
# NEXT_PUBLIC_LAUNCH_DATE="2026-11-15T18:00:00+05:00"
# WAITLIST_WEBHOOK_URL=""
